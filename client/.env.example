# Leave VITE_API_URL empty to call the API through the same origin (/api):
#   • locally via the Vite proxy
#   • on Vercel via the rewrite in vercel.json (keeps the refresh cookie first-party)
VITE_API_URL=

# Socket.io must connect straight to the API host (Vercel rewrites don't proxy WebSockets).
# Leave empty locally (Vite proxies /socket.io). On Vercel: https://YOUR-API.onrender.com
VITE_SOCKET_URL=
