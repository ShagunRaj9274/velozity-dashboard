# ── Server ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── Database (PostgreSQL) ──────────────────────────────
# docker compose uses: postgresql://velozity:velozity@db:5432/velozity
DATABASE_URL=postgresql://velozity:velozity@localhost:5432/velozity

# ── Auth ───────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-DIFFERENT-long-random-string-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# ── Browser / cookies ──────────────────────────────────
# Comma-separated list of allowed origins (CORS + Socket.io)
CLIENT_ORIGIN=http://localhost:5173
# lax  → frontend proxies /api (same-site; default, used with Vercel rewrites)
# none → frontend calls the API cross-site (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ── Background job ─────────────────────────────────────
OVERDUE_CRON="* * * * *"

# Reverse-proxy hops in front of the API (1 = local/compose; 2 = Vercel rewrite → Render)
TRUST_PROXY_HOPS=1
